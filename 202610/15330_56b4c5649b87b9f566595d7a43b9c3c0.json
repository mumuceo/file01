   {
    "bookSourceName": "笔趣阁小说（bqgsn）",
    "bookSourceUrl": "https://m.bqgsn.cc",
    "bookSourceType": 0,
    "bookSourceGroup": "自制书源",
    "bookSourceComment": "基于 m.bqgsn.cc 当前前端实际使用的 apibi.cc JSON 接口；目录和正文 token 使用站点同款 AES/CBC/PKCS7 算法动态生成。",
    "enabled": true,
    "enabledExplore": false,
    "enabledCookieJar": true,
    "header": "{\"User-Agent\":\"Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1\",\"Referer\":\"https://m.bqgsn.cc/\"}",
    "searchUrl": "https://apibi.cc/api/search?q={{key}}",
    "jsLib": "function bqCipher(){var code=java.md5Encode('book@token.html');return java.createSymmetricCrypto('AES/CBC/PKCS7Padding',code.substring(16),code.substring(0,16));}\nfunction bqApi(type,payload){var token=bqCipher().encryptBase64(JSON.stringify(payload));return 'https://apibi.cc/api/'+type+'?token='+encodeURIComponent(token);}\nfunction bqCover(id){id=String(id);return 'https://www.bqgsn.cc/bookimg/'+Math.floor(Number(id)/1000)+'/'+id+'.jpg';}",
    "ruleSearch": {
      "bookList": "$.data",
      "name": "$.title",
      "author": "$.author",
      "intro": "$.intro",
      "coverUrl": "<js>bqCover(result.id);</js>",
      "bookUrl": "<js>bqApi('book',{id:String(result.id)});</js>",
      "hasMoreRule": "false"
    },
    "ruleBookInfo": {
      "name": "$.title",
      "author": "$.author",
      "coverUrl": "<js>bqCover(result.id);</js>",
      "intro": "$.intro",
      "kind": "<js>[result.sortname,result.full].filter(function(v){return !!v;}).join(' / ');</js>",
      "lastChapter": "$.lastchapter",
      "updateTime": "$.lastupdate",
      "tocUrl": "<js>var meta={bookId:Number(result.id),dirId:String(result.dirid||result.id)};'data:;base64,'+java.base64Encode(JSON.stringify(meta));</js>"
    },
    "ruleToc": {
      "chapterList": "<js>var meta=result;var raw=java.ajax(bqApi('booklist',{id:String(meta.dirId)}));var list=JSON.parse(String(raw)).list||[];list.map(function(title,index){return {title:String(title),bookId:Number(meta.bookId),chapterId:index+1};});</js>",
      "chapterName": "$.title",
      "chapterUrl": "<js>bqApi('chapter',{id:Number(result.bookId),chapterid:Number(result.chapterId)});</js>",
      "nextTocUrl": ""
    },
    "ruleContent": {
      "title": "$.chaptername",
      "content": "$.txt",
      "nextContentUrl": "",
      "replaceRegex": ""
    }
  },
